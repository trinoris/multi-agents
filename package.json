{
  "name": "trinoris-multi-agents",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-agent coordination protocol",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:coverage": "pnpm --recursive exec vitest run --coverage.enabled --coverage.provider=v8 --coverage.include=\"src/**/*.ts\" --coverage.exclude=\"src/bin.ts\" --coverage.thresholds.branches=80",
    "lint": "turbo run lint",
    "dev": "turbo run dev --parallel",
    "simulate": "pnpm --filter @trinoris/agent-cli build && node simulation/run.mjs",
    "clean": "turbo run clean && rm -rf node_modules",
    "release": "bash scripts/release.sh",
    "release:dry": "bash scripts/release.sh --dry-run"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.12",
    "turbo": "2.9.14",
    "typescript": "^5.3.0",
    "vitest": "^4.0.0",
    "yaml": "2.9.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/trinoris/multi-agents.git"
  },
  "bugs": {
    "url": "https://github.com/trinoris/multi-agents/issues"
  },
  "homepage": "https://github.com/trinoris/multi-agents#readme",
  "packageManager": "pnpm@8.12.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.2"
    }
  }
}
